[
  {
    "title": "七步诗",
    "author": "曹植",
    "dynasty": "三国",
    "lines": [
      "煮豆燃豆萁",
      "豆在釜中泣",
      "本是同根生",
      "相煎何太急"
    ],
    "note": "兄弟相逼的千古悲音"
  },
  {
    "title": "赠范晔诗",
    "author": "陆凯",
    "dynasty": "南北朝",
    "lines": [
      "折花逢驿使",
      "寄与陇头人",
      "江南无所有",
      "聊赠一枝春"
    ],
    "note": "聊赠一枝春，赠别佳话之源"
  },
  {
    "title": "山中杂诗",
    "author": "吴均",
    "dynasty": "南北朝",
    "lines": [
      "山际见来烟",
      "竹中窥落日",
      "鸟向檐上飞",
      "云从窗里出"
    ],
    "note": "云从窗里出，山居闲趣"
  },
  {
    "title": "重别周尚书",
    "author": "庾信",
    "dynasty": "南北朝",
    "lines": [
      "阳关万里道",
      "不见一人归",
      "惟有河边雁",
      "秋来南向飞"
    ],
    "note": "乡关之思托于南飞雁"
  },
  {
    "title": "人日思归",
    "author": "薛道衡",
    "dynasty": "隋",
    "lines": [
      "入春才七日",
      "离家已二年",
      "人归落雁后",
      "思发在花前"
    ],
    "note": "归心早发，人却落在雁后"
  },
  {
    "title": "蝉",
    "author": "虞世南",
    "dynasty": "唐",
    "lines": [
      "垂緌饮清露",
      "流响出疏桐",
      "居高声自远",
      "非是藉秋风"
    ],
    "note": "居高声自远，咏物言志典范"
  },
  {
    "title": "风",
    "author": "李峤",
    "dynasty": "唐",
    "lines": [
      "解落三秋叶",
      "能开二月花",
      "过江千尺浪",
      "入竹万竿斜"
    ],
    "note": "全诗不着风字而处处是风"
  },
  {
    "title": "于易水送人",
    "author": "骆宾王",
    "dynasty": "唐",
    "lines": [
      "此地别燕丹",
      "壮士发冲冠",
      "昔时人已没",
      "今日水犹寒"
    ],
    "note": "借荆轲抒英雄失路之悲"
  },
  {
    "title": "山中",
    "author": "王勃",
    "dynasty": "唐",
    "lines": [
      "长江悲已滞",
      "万里念将归",
      "况属高风晚",
      "山山黄叶飞"
    ],
    "note": "万里旅愁与漫山黄叶"
  },
  {
    "title": "夜送赵纵",
    "author": "杨炯",
    "dynasty": "唐",
    "lines": [
      "赵氏连城璧",
      "由来天下传",
      "送君还旧府",
      "明月满前川"
    ],
    "note": "用完璧归赵典故送友还乡"
  },
  {
    "title": "曲池荷",
    "author": "卢照邻",
    "dynasty": "唐",
    "lines": [
      "浮香绕曲岸",
      "圆影覆华池",
      "常恐秋风早",
      "飘零君不知"
    ],
    "note": "借荷自伤，常恐秋风早"
  },
  {
    "title": "渡汉江",
    "author": "宋之问",
    "dynasty": "唐",
    "lines": [
      "岭外音书断",
      "经冬复历春",
      "近乡情更怯",
      "不敢问来人"
    ],
    "note": "近乡情更怯道尽游子心理"
  },
  {
    "title": "蜀道后期",
    "author": "张说",
    "dynasty": "唐",
    "lines": [
      "客心争日月",
      "来往预期程",
      "秋风不相待",
      "先至洛阳城"
    ],
    "note": "秋风不等人，归期已误"
  },
  {
    "title": "赋得自君之出矣",
    "author": "张九龄",
    "dynasty": "唐",
    "lines": [
      "自君之出矣",
      "不复理残机",
      "思君如满月",
      "夜夜减清辉"
    ],
    "note": "思君如满月，夜夜减清辉"
  },
  {
    "title": "汾上惊秋",
    "author": "苏颋",
    "dynasty": "唐",
    "lines": [
      "北风吹白云",
      "万里渡河汾",
      "心绪逢摇落",
      "秋声不可闻"
    ],
    "note": "北风白云间一声秋叹"
  },
  {
    "title": "鹿柴",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "空山不见人",
      "但闻人语响",
      "返景入深林",
      "复照青苔上"
    ],
    "note": "空山人语，光影禅意"
  },
  {
    "title": "竹里馆",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "独坐幽篁里",
      "弹琴复长啸",
      "深林人不知",
      "明月来相照"
    ],
    "note": "深林明月，独坐自得"
  },
  {
    "title": "送别",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "山中相送罢",
      "日暮掩柴扉",
      "春草明年绿",
      "王孙归不归"
    ],
    "note": "春草明年绿，王孙归不归"
  },
  {
    "title": "相思",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "红豆生南国",
      "春来发几枝",
      "愿君多采撷",
      "此物最相思"
    ],
    "note": "红豆从此成相思信物"
  },
  {
    "title": "杂诗",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "君自故乡来",
      "应知故乡事",
      "来日绮窗前",
      "寒梅著花未"
    ],
    "note": "只问窗前寒梅，乡思入微"
  },
  {
    "title": "鸟鸣涧",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "人闲桂花落",
      "夜静春山空",
      "月出惊山鸟",
      "时鸣春涧中"
    ],
    "note": "以动衬静的春山月夜"
  },
  {
    "title": "山中",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "荆溪白石出",
      "天寒红叶稀",
      "山路元无雨",
      "空翠湿人衣"
    ],
    "note": "山路无雨，空翠湿衣"
  },
  {
    "title": "辛夷坞",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "木末芙蓉花",
      "山中发红萼",
      "涧户寂无人",
      "纷纷开且落"
    ],
    "note": "无人处花开花落，寂静自足"
  },
  {
    "title": "息夫人",
    "author": "王维",
    "dynasty": "唐",
    "lines": [
      "莫以今时宠",
      "能忘旧日恩",
      "看花满眼泪",
      "不共楚王言"
    ],
    "note": "看花满眼泪，不忘旧恩"
  },
  {
    "title": "送崔九",
    "author": "裴迪",
    "dynasty": "唐",
    "lines": [
      "归山深浅去",
      "须尽丘壑美",
      "莫学武陵人",
      "暂游桃源里"
    ],
    "note": "劝友归隐莫学武陵人"
  },
  {
    "title": "终南望余雪",
    "author": "祖咏",
    "dynasty": "唐",
    "lines": [
      "终南阴岭秀",
      "积雪浮云端",
      "林表明霁色",
      "城中增暮寒"
    ],
    "note": "应试只写四句的咏雪名作"
  },
  {
    "title": "春晓",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": [
      "春眠不觉晓",
      "处处闻啼鸟",
      "夜来风雨声",
      "花落知多少"
    ],
    "note": "花落知多少，妇孺皆知"
  },
  {
    "title": "宿建德江",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": [
      "移舟泊烟渚",
      "日暮客愁新",
      "野旷天低树",
      "江清月近人"
    ],
    "note": "野旷天低树，羁旅愁思"
  },
  {
    "title": "送朱大入秦",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": [
      "游人五陵去",
      "宝剑值千金",
      "分手脱相赠",
      "平生一片心"
    ],
    "note": "解剑相赠，一片侠肠"
  },
  {
    "title": "静夜思",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "床前明月光",
      "疑是地上霜",
      "举头望明月",
      "低头思故乡"
    ],
    "note": "千年来中国人最熟悉的乡愁"
  },
  {
    "title": "独坐敬亭山",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "众鸟高飞尽",
      "孤云独去闲",
      "相看两不厌",
      "只有敬亭山"
    ],
    "note": "相看两不厌的孤独与安顿"
  },
  {
    "title": "夜宿山寺",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "危楼高百尺",
      "手可摘星辰",
      "不敢高声语",
      "恐惊天上人"
    ],
    "note": "手可摘星辰，童心与豪气"
  },
  {
    "title": "秋浦歌",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "白发三千丈",
      "缘愁似个长",
      "不知明镜里",
      "何处得秋霜"
    ],
    "note": "白发三千丈，夸张写愁绝唱"
  },
  {
    "title": "怨情",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "美人卷珠帘",
      "深坐颦蛾眉",
      "但见泪痕湿",
      "不知心恨谁"
    ],
    "note": "不知心恨谁，含蓄之极"
  },
  {
    "title": "玉阶怨",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "玉阶生白露",
      "夜久侵罗袜",
      "却下水晶帘",
      "玲珑望秋月"
    ],
    "note": "不着怨字而怨意深长"
  },
  {
    "title": "劳劳亭",
    "author": "李白",
    "dynasty": "唐",
    "lines": [
      "天下伤心处",
      "劳劳送客亭",
      "春风知别苦",
      "不遣柳条青"
    ],
    "note": "春风知别苦，不遣柳条青"
  },
  {
    "title": "八阵图",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": [
      "功盖三分国",
      "名成八阵图",
      "江流石不转",
      "遗恨失吞吴"
    ],
    "note": "咏诸葛亮，遗恨失吞吴"
  },
  {
    "title": "绝句二首·其一",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": [
      "迟日江山丽",
      "春风花草香",
      "泥融飞燕子",
      "沙暖睡鸳鸯"
    ],
    "note": "迟日江山丽，课本咏春名篇"
  },
  {
    "title": "绝句二首·其二",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": [
      "江碧鸟逾白",
      "山青花欲燃",
      "今春看又过",
      "何日是归年"
    ],
    "note": "色彩明丽，结句陡转思乡"
  },
  {
    "title": "登鹳雀楼",
    "author": "王之涣",
    "dynasty": "唐",
    "lines": [
      "白日依山尽",
      "黄河入海流",
      "欲穷千里目",
      "更上一层楼"
    ],
    "note": "更上一层楼，进取精神象征"
  },
  {
    "title": "长干行·其一",
    "author": "崔颢",
    "dynasty": "唐",
    "lines": [
      "君家何处住",
      "妾住在横塘",
      "停船暂借问",
      "或恐是同乡"
    ],
    "note": "船家女问乡，质朴如白话"
  },
  {
    "title": "长干行·其二",
    "author": "崔颢",
    "dynasty": "唐",
    "lines": [
      "家临九江水",
      "来去九江侧",
      "同是长干人",
      "生小不相识"
    ],
    "note": "同是长干人，答得憨厚"
  },
  {
    "title": "行军九日思长安故园",
    "author": "岑参",
    "dynasty": "唐",
    "lines": [
      "强欲登高去",
      "无人送酒来",
      "遥怜故园菊",
      "应傍战场开"
    ],
    "note": "战乱重阳，遥怜故园菊"
  },
  {
    "title": "送灵澈上人",
    "author": "刘长卿",
    "dynasty": "唐",
    "lines": [
      "苍苍竹林寺",
      "杳杳钟声晚",
      "荷笠带斜阳",
      "青山独归远"
    ],
    "note": "青山独归远，淡远送别"
  },
  {
    "title": "弹琴",
    "author": "刘长卿",
    "dynasty": "唐",
    "lines": [
      "泠泠七弦上",
      "静听松风寒",
      "古调虽自爱",
      "今人多不弹"
    ],
    "note": "古调虽自爱，知音难觅"
  },
  {
    "title": "送上人",
    "author": "刘长卿",
    "dynasty": "唐",
    "lines": [
      "孤云将野鹤",
      "岂向人间住",
      "莫买沃洲山",
      "时人已知处"
    ],
    "note": "劝僧友莫住名山避俗"
  },
  {
    "title": "逢雪宿芙蓉山主人",
    "author": "刘长卿",
    "dynasty": "唐",
    "lines": [
      "日暮苍山远",
      "天寒白屋贫",
      "柴门闻犬吠",
      "风雪夜归人"
    ],
    "note": "风雪夜归人，千古暖意"
  },
  {
    "title": "秋夜寄邱员外",
    "author": "韦应物",
    "dynasty": "唐",
    "lines": [
      "怀君属秋夜",
      "散步咏凉天",
      "空山松子落",
      "幽人应未眠"
    ],
    "note": "空山松子落，怀人清绝"
  },
  {
    "title": "闻雁",
    "author": "韦应物",
    "dynasty": "唐",
    "lines": [
      "故园渺何处",
      "归思方悠哉",
      "淮南秋雨夜",
      "高斋闻雁来"
    ],
    "note": "秋雨高斋，一声雁起乡思"
  },
  {
    "title": "塞下曲·其一",
    "author": "卢纶",
    "dynasty": "唐",
    "lines": [
      "鹫翎金仆姑",
      "燕尾绣蝥弧",
      "独立扬新令",
      "千营共一呼"
    ],
    "note": "将军发令，千营一呼"
  },
  {
    "title": "塞下曲·其二",
    "author": "卢纶",
    "dynasty": "唐",
    "lines": [
      "林暗草惊风",
      "将军夜引弓",
      "平明寻白羽",
      "没在石棱中"
    ],
    "note": "箭没石棱，写李广神勇"
  },
  {
    "title": "塞下曲·其三",
    "author": "卢纶",
    "dynasty": "唐",
    "lines": [
      "月黑雁飞高",
      "单于夜遁逃",
      "欲将轻骑逐",
      "大雪满弓刀"
    ],
    "note": "月黑雪夜，轻骑逐单于"
  },
  {
    "title": "塞下曲·其四",
    "author": "卢纶",
    "dynasty": "唐",
    "lines": [
      "野幕敞琼筵",
      "羌戎贺劳旋",
      "醉和金甲舞",
      "雷鼓动山川"
    ],
    "note": "破敌庆功，醉舞金甲"
  },
  {
    "title": "江南曲",
    "author": "李益",
    "dynasty": "唐",
    "lines": [
      "嫁得瞿塘贾",
      "朝朝误妾期",
      "早知潮有信",
      "嫁与弄潮儿"
    ],
    "note": "早知潮有信，闺怨奇语"
  },
  {
    "title": "听筝",
    "author": "李端",
    "dynasty": "唐",
    "lines": [
      "鸣筝金粟柱",
      "素手玉房前",
      "欲得周郎顾",
      "时时误拂弦"
    ],
    "note": "误拂弦只为周郎一顾"
  },
  {
    "title": "拜新月",
    "author": "李端",
    "dynasty": "唐",
    "lines": [
      "开帘见新月",
      "便即下阶拜",
      "细语人不闻",
      "北风吹裙带"
    ],
    "note": "细语人不闻，少女心事"
  },
  {
    "title": "新嫁娘词",
    "author": "王建",
    "dynasty": "唐",
    "lines": [
      "三日入厨下",
      "洗手作羹汤",
      "未谙姑食性",
      "先遣小姑尝"
    ],
    "note": "先遣小姑尝，新妇聪慧"
  },
  {
    "title": "玉台体",
    "author": "权德舆",
    "dynasty": "唐",
    "lines": [
      "昨夜裙带解",
      "今朝蟢子飞",
      "铅华不可弃",
      "莫是藁砧归"
    ],
    "note": "占喜兆盼夫归的小儿女心"
  },
  {
    "title": "古别离",
    "author": "孟郊",
    "dynasty": "唐",
    "lines": [
      "欲别牵郎衣",
      "郎今到何处",
      "不恨归来迟",
      "莫向临邛去"
    ],
    "note": "莫向临邛去，痴语见深情"
  },
  {
    "title": "过三闾庙",
    "author": "戴叔伦",
    "dynasty": "唐",
    "lines": [
      "沅湘流不尽",
      "屈子怨何深",
      "日暮秋风起",
      "萧萧枫树林"
    ],
    "note": "凭吊屈原，枫林萧萧"
  },
  {
    "title": "江雪",
    "author": "柳宗元",
    "dynasty": "唐",
    "lines": [
      "千山鸟飞绝",
      "万径人踪灭",
      "孤舟蓑笠翁",
      "独钓寒江雪"
    ],
    "note": "孤舟独钓，孤绝意境之巅"
  },
  {
    "title": "行宫",
    "author": "元稹",
    "dynasty": "唐",
    "lines": [
      "寥落古行宫",
      "宫花寂寞红",
      "白头宫女在",
      "闲坐说玄宗"
    ],
    "note": "白头宫女闲话，盛衰无限"
  },
  {
    "title": "问刘十九",
    "author": "白居易",
    "dynasty": "唐",
    "lines": [
      "绿蚁新醅酒",
      "红泥小火炉",
      "晚来天欲雪",
      "能饮一杯无"
    ],
    "note": "能饮一杯无，最暖的邀约"
  },
  {
    "title": "池上",
    "author": "白居易",
    "dynasty": "唐",
    "lines": [
      "小娃撑小艇",
      "偷采白莲回",
      "不解藏踪迹",
      "浮萍一道开"
    ],
    "note": "小娃偷采莲，童趣天成"
  },
  {
    "title": "夜雪",
    "author": "白居易",
    "dynasty": "唐",
    "lines": [
      "已讶衾枕冷",
      "复见窗户明",
      "夜深知雪重",
      "时闻折竹声"
    ],
    "note": "时闻折竹声，侧写夜雪"
  },
  {
    "title": "遗爱寺",
    "author": "白居易",
    "dynasty": "唐",
    "lines": [
      "弄石临溪坐",
      "寻花绕寺行",
      "时时闻鸟语",
      "处处是泉声"
    ],
    "note": "鸟语泉声，随处可喜"
  },
  {
    "title": "南浦别",
    "author": "白居易",
    "dynasty": "唐",
    "lines": [
      "南浦凄凄别",
      "西风袅袅秋",
      "一看肠一断",
      "好去莫回头"
    ],
    "note": "一看肠一断，送别难回头"
  },
  {
    "title": "悯农·其一",
    "author": "李绅",
    "dynasty": "唐",
    "lines": [
      "春种一粒粟",
      "秋收万颗子",
      "四海无闲田",
      "农夫犹饿死"
    ],
    "note": "四海无闲田，农夫犹饿死"
  },
  {
    "title": "悯农·其二",
    "author": "李绅",
    "dynasty": "唐",
    "lines": [
      "锄禾日当午",
      "汗滴禾下土",
      "谁知盘中餐",
      "粒粒皆辛苦"
    ],
    "note": "粒粒皆辛苦，启蒙第一课"
  },
  {
    "title": "秋风引",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": [
      "何处秋风至",
      "萧萧送雁群",
      "朝来入庭树",
      "孤客最先闻"
    ],
    "note": "孤客最先闻，秋声入心"
  },
  {
    "title": "寻隐者不遇",
    "author": "贾岛",
    "dynasty": "唐",
    "lines": [
      "松下问童子",
      "言师采药去",
      "只在此山中",
      "云深不知处"
    ],
    "note": "云深不知处，一问三答"
  },
  {
    "title": "剑客",
    "author": "贾岛",
    "dynasty": "唐",
    "lines": [
      "十年磨一剑",
      "霜刃未曾试",
      "今日把示君",
      "谁有不平事"
    ],
    "note": "十年磨一剑，快意自许"
  },
  {
    "title": "题诗后",
    "author": "贾岛",
    "dynasty": "唐",
    "lines": [
      "二句三年得",
      "一吟双泪流",
      "知音如不赏",
      "归卧故山秋"
    ],
    "note": "二句三年得，苦吟自白"
  },
  {
    "title": "马诗",
    "author": "李贺",
    "dynasty": "唐",
    "lines": [
      "大漠沙如雪",
      "燕山月似钩",
      "何当金络脑",
      "快走踏清秋"
    ],
    "note": "何当金络脑，借马言志"
  },
  {
    "title": "登乐游原",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": [
      "向晚意不适",
      "驱车登古原",
      "夕阳无限好",
      "只是近黄昏"
    ],
    "note": "夕阳无限好，只是近黄昏"
  },
  {
    "title": "天涯",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": [
      "春日在天涯",
      "天涯日又斜",
      "莺啼如有泪",
      "为湿最高花"
    ],
    "note": "春日在天涯，凄艳之绝"
  },
  {
    "title": "何满子",
    "author": "张祜",
    "dynasty": "唐",
    "lines": [
      "故国三千里",
      "深宫二十年",
      "一声何满子",
      "双泪落君前"
    ],
    "note": "一声何满子，宫人之悲"
  },
  {
    "title": "春怨",
    "author": "金昌绪",
    "dynasty": "唐",
    "lines": [
      "打起黄莺儿",
      "莫教枝上啼",
      "啼时惊妾梦",
      "不得到辽西"
    ],
    "note": "打起黄莺只为梦到辽西"
  },
  {
    "title": "哥舒歌",
    "author": "西鄙人",
    "dynasty": "唐",
    "lines": [
      "北斗七星高",
      "哥舒夜带刀",
      "至今窥牧马",
      "不敢过临洮"
    ],
    "note": "边地民谣颂哥舒翰威名"
  },
  {
    "title": "雪",
    "author": "罗隐",
    "dynasty": "唐",
    "lines": [
      "尽道丰年瑞",
      "丰年事若何",
      "长安有贫者",
      "为瑞不宜多"
    ],
    "note": "为瑞不宜多，替贫者发声"
  },
  {
    "title": "田家",
    "author": "聂夷中",
    "dynasty": "唐",
    "lines": [
      "父耕原上田",
      "子劚山下荒",
      "六月禾未秀",
      "官家已修仓"
    ],
    "note": "禾未秀已修仓，讽赋税苛"
  },
  {
    "title": "答人",
    "author": "太上隐者",
    "dynasty": "唐",
    "lines": [
      "偶来松树下",
      "高枕石头眠",
      "山中无历日",
      "寒尽不知年"
    ],
    "note": "山中无历日，隐者风致"
  },
  {
    "title": "画",
    "author": "佚名",
    "dynasty": "唐",
    "lines": [
      "远看山有色",
      "近听水无声",
      "春去花还在",
      "人来鸟不惊"
    ],
    "note": "课本咏画谜语诗，作者不可考"
  },
  {
    "title": "咏华山",
    "author": "寇准",
    "dynasty": "宋",
    "lines": [
      "只有天在上",
      "更无山与齐",
      "举头红日近",
      "回首白云低"
    ],
    "note": "相传寇准七岁咏华山之作"
  },
  {
    "title": "山村咏怀",
    "author": "邵雍",
    "dynasty": "宋",
    "lines": [
      "一去二三里",
      "烟村四五家",
      "亭台六七座",
      "八九十枝花"
    ],
    "note": "一去二三里，数字入诗启蒙"
  },
  {
    "title": "江上渔者",
    "author": "范仲淹",
    "dynasty": "宋",
    "lines": [
      "江上往来人",
      "但爱鲈鱼美",
      "君看一叶舟",
      "出没风波里"
    ],
    "note": "鲈鱼美背后是风波里人"
  },
  {
    "title": "陶者",
    "author": "梅尧臣",
    "dynasty": "宋",
    "lines": [
      "陶尽门前土",
      "屋上无片瓦",
      "十指不沾泥",
      "鳞鳞居大厦"
    ],
    "note": "烧瓦者无瓦，对比刺世"
  },
  {
    "title": "蚕妇",
    "author": "张俞",
    "dynasty": "宋",
    "lines": [
      "昨日入城市",
      "归来泪满巾",
      "遍身罗绮者",
      "不是养蚕人"
    ],
    "note": "遍身罗绮者，不是养蚕人"
  },
  {
    "title": "梅花",
    "author": "王安石",
    "dynasty": "宋",
    "lines": [
      "墙角数枝梅",
      "凌寒独自开",
      "遥知不是雪",
      "为有暗香来"
    ],
    "note": "遥知不是雪，为有暗香来"
  },
  {
    "title": "江上",
    "author": "王安石",
    "dynasty": "宋",
    "lines": [
      "江水漾西风",
      "江花脱晚红",
      "离情被横笛",
      "吹过乱山东"
    ],
    "note": "离情被横笛吹过乱山"
  },
  {
    "title": "夏日绝句",
    "author": "李清照",
    "dynasty": "宋",
    "lines": [
      "生当作人杰",
      "死亦为鬼雄",
      "至今思项羽",
      "不肯过江东"
    ],
    "note": "至今思项羽，巾帼豪气"
  },
  {
    "title": "京师得家书",
    "author": "袁凯",
    "dynasty": "明",
    "lines": [
      "江水三千里",
      "家书十五行",
      "行行无别语",
      "只道早还乡"
    ],
    "note": "行行无别语，只道早还乡"
  },
  {
    "title": "所见",
    "author": "袁枚",
    "dynasty": "清",
    "lines": [
      "牧童骑黄牛",
      "歌声振林樾",
      "意欲捕鸣蝉",
      "忽然闭口立"
    ],
    "note": "忽然闭口立，牧童神态"
  },
  {
    "title": "苔",
    "author": "袁枚",
    "dynasty": "清",
    "lines": [
      "白日不到处",
      "青春恰自来",
      "苔花如米小",
      "也学牡丹开"
    ],
    "note": "苔花如米小，也学牡丹开"
  },
  {
    "title": "舟夜书所见",
    "author": "查慎行",
    "dynasty": "清",
    "lines": [
      "月黑见渔灯",
      "孤光一点萤",
      "微微风簇浪",
      "散作满河星"
    ],
    "note": "风簇浪散作满河星"
  }
]
